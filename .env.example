# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
#
# Android only: Google Maps needs a free API key (see README § "Google Maps API
# key" for step-by-step instructions). iOS uses Apple Maps and needs no key, so
# you can run on iOS without setting this at all.
GOOGLE_MAPS_API_KEY=your-android-google-maps-api-key-here
